# ─────────────────────────────────────────────────────────────────────────────
# Luqma — environment configuration
# Copy to .env (local) or set these in your hosting provider. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# Neon: use the *pooled* connection string and keep sslmode=require.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL, no trailing slash. Used in e-mails, webhook URLs and gateway
# return URLs. When empty it is derived from the incoming request.
APP_URL=https://luqma.store

# ── Master admin (optional, first start only) ────────────────────────────────
# The master account is created automatically on first start with the username
# and password agreed for Luqma (stored only as a scrypt hash). Set these BEFORE
# the first start to use different credentials. Ignored once the account exists;
# after that, change the password in /admin → Settings.
MASTER_ADMIN_USERNAME=
MASTER_ADMIN_PASSWORD=

# ── Session cookies ──────────────────────────────────────────────────────────
# lax (default) | strict | none. Use "none" only if the app must work inside a
# cross-site iframe; it forces Secure cookies.
COOKIE_SAMESITE=lax
# Force the Secure flag even when the proxy does not send x-forwarded-proto.
COOKIE_SECURE=

# ── E-mail notifications (SMTP) ──────────────────────────────────────────────
# Required for: new report / update published, account activated, payment
# confirmed. Until SMTP_HOST and EMAIL_FROM are set, nothing is sent and every
# attempt is logged as "not configured" in /admin → Settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for implicit TLS (port 465). Leave empty to auto-detect from the port.
SMTP_SECURE=
EMAIL_FROM="Luqma <no-reply@luqma.store>"
# Optional: where the team is told about new inquiries, registrations and orders.
ADMIN_NOTIFY_EMAIL=

# ── Uploads ──────────────────────────────────────────────────────────────────
# Maximum size of one uploaded file in MB (portfolio media, QR code, report files).
# Files are stored in PostgreSQL. On Vercel, request bodies are capped at ~4.5 MB;
# use external links for long videos there.
MAX_UPLOAD_MB=40

# ── Payment gateways ─────────────────────────────────────────────────────────
# Every gateway is DISABLED and in MOCK mode by default. To go live:
#   1. set the credentials below and redeploy,
#   2. register the webhook URL shown in /admin → Payment setup with the provider,
#   3. switch the gateway to "Live" and enable it in /admin → Payment setup.
# Secrets are read from the environment only — they are never stored in the database.

# Tap Payments (cards, Benefit debit, Apple Pay). Webhook: {APP_URL}/api/webhooks/tap
# The secret key also signs webhooks (HMAC-SHA256 "hashstring" header).
TAP_SECRET_KEY=

# BENEFIT Payment Gateway. Notification URL: {APP_URL}/api/webhooks/benefit_gateway
BENEFIT_TRANPORTAL_ID=
BENEFIT_TRANPORTAL_PASSWORD=
# 32-character terminal resource key (AES-256 key for the "trandata" envelope).
BENEFIT_RESOURCE_KEY=
# test (default) | live
BENEFIT_ENV=test

# PayPal. Webhook: {APP_URL}/api/webhooks/paypal  (event: PAYMENT.CAPTURE.COMPLETED)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The webhook ID PayPal shows after you register the webhook URL (used to verify signatures).
PAYPAL_WEBHOOK_ID=
# sandbox (default) | live
PAYPAL_ENV=sandbox
# PayPal cannot process BHD. Amounts are converted to USD at this rate
# (default: the official peg, 1 BHD = 2.6596 USD).
PAYPAL_BHD_TO_USD=
